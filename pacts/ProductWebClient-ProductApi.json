{
  "consumer": {
    "name": "ProductWebClient"
  },
  "interactions": [
    {
      "description": "a request",
      "pending": false,
      "providerStates": [
        {
          "name": "healthy server"
        }
      ],
      "request": {
        "headers": {
          "Accept": [
            "application/json"
          ]
        },
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "body": {
          "content": {
            "status": "ok"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for product 1",
      "pending": false,
      "providerStates": [
        {
          "name": "a product with id 1 exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": [
            "application/json"
          ]
        },
        "method": "GET",
        "path": "/products/1"
      },
      "response": {
        "body": {
          "content": {
            "id": "1",
            "name": "Widget",
            "price": 9.99
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.7",
      "models": "1.3.15"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "ProductApi"
  }
}